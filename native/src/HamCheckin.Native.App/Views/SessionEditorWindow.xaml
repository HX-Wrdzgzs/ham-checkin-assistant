<Window x:Class="HamCheckin.Native.App.Views.SessionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="场次信息"
        Width="560" Height="500" MinWidth="500" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold"/>
        <TextBlock Grid.Row="1" Text="场次元数据只写入本地 SQLite；Excel 路径仅在导出/补同步时使用。"
                   Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,16" TextWrapping="Wrap"/>
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="场次名称" VerticalAlignment="Center"/>
            <TextBox x:Name="NameBox" Grid.Column="1" Style="{StaticResource InputTextBox}" Height="36"/>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="场次日期" VerticalAlignment="Center"/>
            <TextBox x:Name="DateBox" Grid.Column="1" Style="{StaticResource InputTextBox}" Height="36"/>
        </Grid>
        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="主控呼号" VerticalAlignment="Center"/>
            <TextBox x:Name="OperatorBox" Grid.Column="1" Style="{StaticResource InputTextBox}" Height="36"/>
        </Grid>
        <Grid Grid.Row="5" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="中继名称" VerticalAlignment="Center"/>
            <TextBox x:Name="RepeaterBox" Grid.Column="1" Style="{StaticResource InputTextBox}" Height="36"/>
        </Grid>
        <Grid Grid.Row="6" Margin="0,0,0,10">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Excel 路径" VerticalAlignment="Center"/>
            <TextBox x:Name="WorkbookBox" Grid.Column="1" Style="{StaticResource InputTextBox}" Height="36"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="可留空；启动和快速录入不会打开 Excel。" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="2,4,0,0"/>
        </Grid>
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消  Esc" Style="{StaticResource BaseButton}" Padding="14,7" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="保存场次  Enter" Style="{StaticResource PrimaryButton}" Padding="14,7" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
