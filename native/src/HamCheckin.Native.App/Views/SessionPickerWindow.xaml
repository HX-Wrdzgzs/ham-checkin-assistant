<Window x:Class="HamCheckin.Native.App.Views.SessionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择场次" Width="620" Height="520" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="选择本地场次" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="已结束场次默认只读；选择后可在场次信息中重新打开。" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/>
        </StackPanel>
        <ListBox x:Name="SessionList" Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" Background="White"
                 MouseDoubleClick="SessionList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="8,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Date, StringFormat=日期：{0}}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding NextSequence, StringFormat=下一序号：{0}}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消  Esc" Style="{StaticResource BaseButton}" Padding="14,7" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="打开所选场次" Style="{StaticResource PrimaryButton}" Padding="14,7" Click="Select_Click"/>
        </StackPanel>
    </Grid>
</Window>
