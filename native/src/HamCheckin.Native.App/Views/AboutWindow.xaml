<Window x:Class="HamCheckin.Native.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 / 版本"
        Width="650" Height="560" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="HAM 点名助手" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="Windows 原生版 · 快速、离线、键盘优先" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                <TextBlock x:Name="DeveloperText" Text="开发者：BA4THG（HX-Wrdzgzs）" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" AutomationProperties.AutomationId="about-developer"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" CornerRadius="12" Padding="14,8" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="当前版本" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CurrentVersionText" Text="1.0.1" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14" Margin="0,16,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="更新渠道" FontWeight="Bold"/>
                    <TextBlock Text="稳定版" Foreground="{StaticResource SuccessBrush}" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="GitHub Release · main/updates/latest.json · SHA-256" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="HX-Wrdzgzs/ham-checkin-assistant" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                    <TextBlock x:Name="DataPathText" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="版本检查" FontSize="16" FontWeight="Bold"/>
                <TextBlock x:Name="StatusText" Grid.Row="1" Text="点击“检查更新”读取公开 Release 信息；不会影响快速点名。"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,10"/>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="ReleaseNotesText" IsReadOnly="True" BorderThickness="0" Background="{StaticResource SurfaceAltBrush}"
                             Padding="10" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                </ScrollViewer>
                <ProgressBar x:Name="DownloadProgress" Grid.Row="3" Height="6" Minimum="0" Maximum="1" Value="0" Visibility="Collapsed" Margin="0,12,0,0"/>
            </Grid>
        </Border>

        <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CheckButton" Content="检查更新" Style="{StaticResource BaseButton}" Click="CheckButton_Click" Margin="0,0,8,0" AutomationProperties.AutomationId="about-check-update"/>
            <Button x:Name="DownloadButton" Content="下载并安装" Style="{StaticResource PrimaryButton}" Click="DownloadButton_Click" IsEnabled="False" Margin="0,0,8,0" AutomationProperties.AutomationId="about-download-update"/>
            <Button x:Name="SponsorButton" Content="赞助开发" Style="{StaticResource BaseButton}" Click="OpenSponsorButton_Click" Margin="0,0,8,0" AutomationProperties.AutomationId="about-sponsor"/>
            <Button Content="打开 Release 页面" Style="{StaticResource BaseButton}" Click="OpenReleaseButton_Click" Margin="0,0,8,0"/>
            <Button Content="关闭" Style="{StaticResource BaseButton}" Click="CloseButton_Click"/>
        </WrapPanel>
    </Grid>
</Window>
