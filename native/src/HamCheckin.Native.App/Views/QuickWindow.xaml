<Window x:Class="HamCheckin.Native.App.Views.QuickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HAM 点名助手 · 快速输入"
        Width="560" Height="280" MinWidth="420" MinHeight="190"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        DataContextChanged="Window_DataContextChanged"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing">
    <Grid Margin="12" Background="{StaticResource AppBackgroundBrush}" ClipToBounds="True">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" MinWidth="0">
                <TextBlock Text="{Binding SessionTitle}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding SessionMeta}" FontSize="9" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            </StackPanel>
            <CheckBox Grid.Column="1" Content="置顶" IsChecked="True" Margin="10,0,7,0" VerticalAlignment="Center" Checked="Topmost_Checked" Unchecked="Topmost_Unchecked"/>
            <Button Grid.Column="2" Content="×" Style="{StaticResource BaseButton}" Padding="9,2" Click="CloseButton_Click"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,10,0,7">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="QuickInputBox" Height="44" Style="{StaticResource InputTextBox}" FontSize="16" IsEnabled="{Binding IsQuickInputAvailable}" PreviewKeyDown="Input_PreviewKeyDown" TextChanged="QuickInputBox_TextChanged" GotKeyboardFocus="QuickInputBox_GotKeyboardFocus" AutomationProperties.Name="快速点名输入" AutomationProperties.AutomationId="quick-input-window"/>
            <Button x:Name="QuickSubmitButton" Grid.Column="1" Content="提交" Style="{StaticResource PrimaryButton}" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsSessionWritable}" Margin="8,0,0,0" MinWidth="72"/>
        </Grid>
        <ScrollViewer x:Name="QuickContentScrollViewer"
                      Grid.Row="2"
                      VerticalAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      Focusable="False"
                      ClipToBounds="True"
                      PanningMode="VerticalOnly">
            <StackPanel x:Name="QuickParsePanel" VerticalAlignment="Top">
            <UniformGrid Columns="5" Margin="0,0,0,5">
            <Border Style="{StaticResource CardBorder}" Padding="8,5" Margin="0,0,4,0"><StackPanel><TextBlock Text="呼号" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Callsign}" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
            <Border Style="{StaticResource CardBorder}" Padding="8,5" Margin="0,0,4,0"><StackPanel><TextBlock Text="QTH" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Qth}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
            <Border Style="{StaticResource CardBorder}" Padding="8,5" Margin="0,0,4,0"><StackPanel><TextBlock Text="设备" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Device}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
            <Border Style="{StaticResource CardBorder}" Padding="8,5" Margin="0,0,4,0"><StackPanel><TextBlock Text="天线" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Antenna}" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
            <Border Style="{StaticResource CardBorder}" Padding="8,5" Margin="0"><StackPanel><TextBlock Text="功率" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Power}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
            </UniformGrid>
            <StackPanel Margin="0,0,0,4">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasQthCandidates}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="QTH候选（点击确认）" FontSize="10" Foreground="{StaticResource AccentBrush}"/>
                <ItemsControl ItemsSource="{Binding QthCandidates}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" Tag="{Binding}" Click="QthCandidate_Click" Style="{StaticResource BaseButton}" Padding="5,2" Margin="0,2,4,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <Border x:Name="RecentCheckinsCard" Style="{StaticResource CardBorder}" Padding="7,5" Margin="0,1,0,0">
                <StackPanel>
                    <TextBlock Text="最近记录" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                    <ScrollViewer MaxHeight="76" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsControl x:Name="QuickRecentItems" ItemsSource="{Binding RecentCheckins}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="58"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding SequenceNo, StringFormat=#{0}}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CheckinTime}" FontSize="10"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Callsign}" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Qth}" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="QuickFooterGrid" Grid.Row="3" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button Grid.Column="1" Content="打开主窗口" Style="{StaticResource BaseButton}" Padding="10,5" Click="ShowMain_Click"/></Grid>
    </Grid>
</Window>
